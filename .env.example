# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_DEBUG=True
PORT=5000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=sqlite:///parking.sqlite3

# Initial Admin Seed Credentials
